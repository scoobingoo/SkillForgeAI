APP_NAME="SkillForge AI"
APP_ENV=local
APP_KEY=base64:YWljYXJlZXJjb2FjaG9wZW5zb3VyY2Vkey2026xxxx=
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Cổng hiển thị ứng dụng Web (mặc định 3000)
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000

# Cấu hình PostgreSQL 17 + pgvector
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=acc
DB_USERNAME=acc
DB_PASSWORD=acc
DATABASE_URL=postgres://acc:acc@postgres:5432/acc

# Hàng đợi xử lý bất đồng bộ trên PostgreSQL
QUEUE_CONNECTION=database
SESSION_DRIVER=database
CACHE_STORE=database

# Cấu hình AI / Ollama (OpenAI-compatible endpoint)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:4b
EMBED_MODEL=bge-m3
LLM_CONCURRENCY=2
LLM_TIMEOUT=120

# Ngưỡng chuẩn hoá kỹ năng 3 tầng (Skill Normalizer thresholds)
SKILL_VECTOR_ACCEPT_THRESHOLD=0.82
SKILL_VECTOR_LLM_MIN_THRESHOLD=0.65

# Giới hạn tải lên CV PDF (MB)
MAX_UPLOAD_MB=5
